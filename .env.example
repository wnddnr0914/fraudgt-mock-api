# Copy to .env, then start all four services:
# python scripts/run_services.py --env-file .env
# Browser client settings live separately in examples/frontend/.env.example.
ALERT_THRESHOLD=0.8
FRAUDGT_MODEL_VERSION=fraudgt-mock-v1
TYPOLOGY_MODEL_VERSION=typology-mock-v1
GRAPH_DEFAULT_HOPS=2
GRAPH_DEFAULT_LOOKBACK_DAYS=7
# Assumption ONLY for naive synthetic/CSV timestamps; not a SAML-D timezone claim.
SOURCE_TIMEZONE=UTC
# Comma-separated exact frontend origins. No credentials required for this mock.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
